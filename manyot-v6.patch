+    private static class AppChoice {
+        final String label;
+        final String packageName;
+        AppChoice(String label, String packageName) {
+            this.label = label;
+            this.packageName = packageName;
+        }
+    }
+
+    public class AppBridge {
+        @JavascriptInterface
+        public void pickInstalledApp() {
+            runOnUiThread(() -> showInstalledAppsDialog());
+        }
+
+        @JavascriptInterface
+        public boolean openPackage(String packageName) {
+            if (packageName == null || packageName.trim().isEmpty()) return false;
+            try {
+                Intent launch = getPackageManager().getLaunchIntentForPackage(packageName.trim());
+                if (launch == null) {
+                    runOnUiThread(() -> Toast.makeText(MainActivity.this, "לא ניתן לפתוח את האפליקציה", Toast.LENGTH_SHORT).show());
+                    return false;
+                }
+                runOnUiThread(() -> {
+                    try { startActivity(launch); }
+                    catch (Exception e) { Toast.makeText(MainActivity.this, "לא ניתן לפתוח את האפליקציה", Toast.LENGTH_SHORT).show(); }
+                });
+                return true;
+            } catch (Exception e) {
+                return false;
+            }
+        }
+    }
+
+    private void showInstalledAppsDialog() {
+        try {
+            PackageManager pm = getPackageManager();
+            Intent launcher = new Intent(Intent.ACTION_MAIN, null);
+            launcher.addCategory(Intent.CATEGORY_LAUNCHER);
+            List<ResolveInfo> resolved = pm.queryIntentActivities(launcher, PackageManager.MATCH_ALL);
+
+            Map<String, AppChoice> unique = new LinkedHashMap<>();
+            for (ResolveInfo ri : resolved) {
+                if (ri.activityInfo == null || ri.activityInfo.packageName == null) continue;
+                String pkg = ri.activityInfo.packageName;
+                if (getPackageName().equals(pkg)) continue;
+                CharSequence labelSeq = ri.loadLabel(pm);
+                String label = labelSeq == null ? pkg : labelSeq.toString().trim();
+                if (label.isEmpty()) label = pkg;
+                unique.put(pkg, new AppChoice(label, pkg));
+            }
+
+            List<AppChoice> apps = new ArrayList<>(unique.values());
+            Collections.sort(apps, new Comparator<AppChoice>() {
+                @Override
+                public int compare(AppChoice a, AppChoice b) {
+                    return a.label.compareToIgnoreCase(b.label);
+                }
+            });
+
+            if (apps.isEmpty()) {
+                Toast.makeText(this, "לא נמצאו אפליקציות לבחירה", Toast.LENGTH_SHORT).show();
+                return;
+            }
+
+            String[] labels = new String[apps.size()];
+            for (int i = 0; i < apps.size(); i++) labels[i] = apps.get(i).label;
+
+            new AlertDialog.Builder(this)
+                    .setTitle("בחר אפליקציה")
+                    .setItems(labels, (dialog, which) -> {
+                        AppChoice chosen = apps.get(which);
+                        String js = "window.onAndroidAppPicked && window.onAndroidAppPicked("
+                                + JSONObject.quote(chosen.label) + ","
+                                + JSONObject.quote(chosen.packageName) + ");";
+                        webView.evaluateJavascript(js, null);
+                    })
+                    .setNegativeButton("ביטול", null)
+                    .show();
+        } catch (Exception e) {
+            Toast.makeText(this, "לא ניתן להציג את רשימת האפליקציות", Toast.LENGTH_SHORT).show();
+        }
+    }
